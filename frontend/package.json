{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:static": "node scripts/vendor-backend.mjs && tsc -b && vite build && cp dist/index.html dist/404.html && touch dist/.nojekyll",
    "lint": "oxlint",
    "test": "node --test",
    "verify:static": "node scripts/vendor-backend.mjs && node scripts/verify-static-backend.mjs",
    "preview": "vite preview",
    "gen:api": "cd ../backend && python3 -m scripts.export_openapi ../frontend/src/api/openapi.json && cd ../frontend && npx --yes openapi-typescript@7.13.0 src/api/openapi.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.105.1",
    "cytoscape": "^3.34.0",
    "cytoscape-fcose": "2.2.0",
    "d3-geo": "3.1.1",
    "echarts": "6.1.0",
    "pyodide": "0.28.3",
    "react": "^19.2.8",
    "react-cytoscapejs": "^2.0.0",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "topojson-client": "3.1.0",
    "world-atlas": "2.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/d3-geo": "3.1.0",
    "@types/geojson": "7946.0.16",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/topojson-client": "3.1.5",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
