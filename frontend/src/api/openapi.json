        "maxLength": 100,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Geography"
     },
     "max_hops": {
      "default": 2,
      "maximum": 3.0,
      "minimum": 1.0,
      "title": "Max Hops",
      "type": "integer"
     },
     "min_score": {
      "default": 0.05,
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Min Score",
      "type": "number"
     },
     "sector": {
      "anyOf": [
       {
        "maxLength": 100,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Sector"
     },
     "text": {
      "maxLength": 20000,
      "title": "Text",
      "type": "string"
     },
     "top_k": {
      "default": 15,
      "maximum": 50.0,
      "minimum": 1.0,
      "title": "Top K",
      "type": "integer"
     }
    },
    "required": [
     "text"
    ],
    "title": "EventParseRequest",
    "type": "object"
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "title": "Detail",
      "type": "array"
     }
    },
    "title": "HTTPValidationError",
    "type": "object"
   },
   "IngestDocument": {
    "properties": {
     "date": {
      "description": "ISO date, YYYY-MM-DD",
      "title": "Date",
      "type": "string"
     },
     "entities": {
      "anyOf": [
       {
        "items": {
         "maxLength": 64,
         "minLength": 1,
         "type": "string"
        },
        "maxItems": 50,
        "type": "array"
       },
       {
        "type": "null"
       }
      ],
      "title": "Entities"
     },
     "id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$",
      "title": "Id",
      "type": "string"
     },
     "is_synthetic": {
      "anyOf": [
       {
        "type": "boolean"
       },
       {
        "type": "null"
       }
      ],
      "default": true,
      "title": "Is Synthetic"
     },
     "keywords": {
      "anyOf": [
       {
        "items": {
         "maxLength": 64,
         "minLength": 1,
         "type": "string"
        },
        "maxItems": 50,
        "type": "array"
       },
       {
        "type": "null"
       }
      ],
      "title": "Keywords"
     },
     "snippet": {
      "maxLength": 5000,
      "minLength": 1,
      "title": "Snippet",
      "type": "string"
     },
     "source": {
      "anyOf": [
       {
        "maxLength": 100,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Source"
     },
     "title": {
      "maxLength": 300,
      "minLength": 1,
      "title": "Title",
      "type": "string"
     },
     "url": {
      "anyOf": [
       {
        "maxLength": 500,
        "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://\\S+$",
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Url"
     }
    },
    "required": [
     "id",
     "date",
     "title",
     "snippet"
    ],
    "title": "IngestDocument",
    "type": "object"
   },
