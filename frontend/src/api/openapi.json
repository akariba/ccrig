      "type": "number"
     },
     "lam": {
      "default": 2.0,
      "maximum": 1000.0,
      "minimum": 0.0,
      "title": "Lam",
      "type": "number"
     },
     "starting_weights": {
      "anyOf": [
       {
        "additionalProperties": {
         "type": "number"
        },
        "type": "object"
       },
       {
        "type": "null"
       }
      ],
      "title": "Starting Weights"
