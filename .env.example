# CCRIG AI Analyst Platform (POC) — environment configuration
#
# All AI settings are OPTIONAL. The application is fully functional offline
# without any of these set: candidate generation, relationship scoring,
# graph traversal, backtesting, and every view work with the built-in
# DeterministicProvider (regex/keyword based extraction + templated
# explanations). Setting the three variables below switches the AI Copilot
# and explanation surfaces to an OpenAI-compatible LLM for richer natural-
# language parsing, labelling, and explanation text — it is NEVER used for
# bulk pairwise relationship scoring (see docs/LIMITATIONS.md and
# backend/app/ai/provider.py).
#
# To enable: copy this file to backend/.env (or export the same variables
# in your shell) and fill in a real OpenAI-compatible endpoint.

# Base URL of an OpenAI-compatible chat completions API, e.g.:
#   https://api.openai.com/v1
#   https://api.groq.com/openai/v1
AI_BASE_URL=

# API key / bearer token for the endpoint above.
AI_API_KEY=

# Model name to request, e.g. gpt-4o-mini, llama-3.1-70b-versatile.
AI_MODEL=

# If any of the three variables above is blank, the app runs in
# "Offline deterministic mode" — this is clearly indicated in the UI
# sidebar badge at all times.
