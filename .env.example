# CCRIG AI Analyst Platform (POC) — environment configuration
#
# All AI settings are OPTIONAL. The application is fully functional offline
# without any of these set: candidate generation, relationship scoring,
# graph traversal, backtesting, and every view work with the built-in
# DeterministicProvider (regex/keyword based extraction + templated
# explanations). Setting the three variables below switches the AI Copilot
# and explanation surfaces to an OpenAI-compatible LLM for richer natural-
# language parsing, labelling, and explanation text — it is NEVER used for
# bulk pairwise relationship scoring (see docs/LIMITATIONS.md and
# backend/app/ai/provider.py).
#
# To enable: export the variables in your shell, or copy this file to
# backend/.env and start the server with `--env-file`:
#   python3 -m uvicorn app.main:app --env-file .env
# (the app reads process environment variables only; it does not load a
# .env file by itself).

# Base URL of an OpenAI-compatible chat completions API, e.g.:
#   https://api.openai.com/v1
#   https://api.groq.com/openai/v1
AI_BASE_URL=

# API key / bearer token for the endpoint above.
AI_API_KEY=

# Model name to request, e.g. gpt-4o-mini, llama-3.1-70b-versatile.
AI_MODEL=

# If any of the three variables above is blank, the app runs in
# "Offline deterministic mode" — this is clearly indicated in the UI
# sidebar badge at all times.

# --- Document ingestion (optional, off by default) ---------------------------
# POST /api/themes/ingest appends a news document to the shared, in-memory
# corpus behind Theme Radar. Because that state is shared by every viewer, the
# endpoint answers 403 unless this is set to 1/true/yes/on. Ingested text is
# always labelled synthetic / unverified, ids must be unique, and at most 200
# documents can be added. Not needed for any shipped view.
CCRIG_ENABLE_INGEST=

# --- CORS (only needed when the frontend is served from a different origin) --
# The API uses no cookies or authentication, so credentialed CORS is never
# enabled. By default only local development origins (localhost, 127.0.0.1,
# ::1 on any port) may read API responses; the Vite dev proxy and the
# serverless GitHub Pages build need no configuration. For a deployment where
# the frontend lives elsewhere (e.g. the Render static site, see render.yaml),
# set ONE of:
#   CCRIG_CORS_ORIGINS=https://app.example.com,https://other.example.com
#   CCRIG_CORS_ORIGIN_REGEX=^https://ccrig-frontend(-[a-z0-9]+)?\.onrender\.com$
# ("*" is accepted in CCRIG_CORS_ORIGINS as an explicit opt-in.) A malformed
# value stops the server at startup with a clear message.
CCRIG_CORS_ORIGINS=
CCRIG_CORS_ORIGIN_REGEX=
